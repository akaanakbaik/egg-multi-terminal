    "name": "Aka Multi Terminal",
    "author": "akaanakbaik17@proton.me",
    "description": "Multi terminal egg untuk menjalankan bot dan web dengan Node.js, Python, PHP, C/C++, Java, Go, Bun, Deno, PM2, dan Cloudflare Tunnel.",
    "features": null,
    "docker_images": {
        "Aka Multi Terminal - Nightly": "ghcr.io/akaanakbaik/egg-multi-terminal:nightly",
        "Aka Multi Terminal - Latest": "ghcr.io/akaanakbaik/egg-multi-terminal:latest"
    },
    "file_denylist": [],
    "startup": "bash",
    "config": {
        "files": "{}",
        "startup": "{\n    \"done\": \"AKA_MULTI_TERMINAL_READY\"\n}",
        "logs": "{}",
        "stop": "exit"
    },
    "scripts": {
        "installation": {
            "script": "#!/bin/bash\nmkdir -p /mnt/server\ncd /mnt/server\necho Ready\n",
            "container": "ubuntu:24.04",
            "entrypoint": "bash"
        }
    },
    "variables": [
        {
            "name": "Startup Command",
            "description": "Command yang dijalankan saat server start. Isi bash untuk terminal interaktif.",
            "env_variable": "STARTUP_CMD",
            "default_value": "bash",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|string|max:4096",
            "field_type": "text"
        },
        {
            "name": "Show Runtime Info",
            "description": "Isi 1 untuk menampilkan banner dan versi runtime, 0 untuk sembunyikan.",
            "env_variable": "AKA_SHOW_INFO",
            "default_value": "1",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|boolean",
            "field_type": "text"
        }
    ]
}
